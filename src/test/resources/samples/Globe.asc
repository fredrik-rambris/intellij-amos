Load Iff "Globe.iff",1 : Screen Hide
Screen Open 0,128,128,32,Lowres
Flash Off
Curs Off : Paper 0 : Pen 1
Get Palette 1
Cls
Degree

If Length(10)=0
   Reserve As Data 10,$8000
   For X=0 To $7FFF Step 4
      Loke Start(10)+X,$FFFFFFFF
   Next X

   Print "Precalculating..."

   For Y#=-64 To 0 Step 0.4
      For X#=-64 To 0 Step 0.4
         DIST#=Sqr((Abs(X#)^2)+(Abs(Y#)^2))/4
         X=64+((X#*3.45)*Tan(32-DIST#))
         Y=64+((Y#*3.45)*Tan(32-DIST#))
         POS=(Y*256)+(X*2)
         Poke Start(10)+POS,X#+64
         Poke Start(10)+POS+1,Y#+64

         X=64+((Abs(X#)*3.45)*Tan(32-DIST#))
         Y=64+((Y#*3.45)*Tan(32-DIST#))
         POS=(Y*256)+(X*2)
         Poke Start(10)+POS,Abs(X#)+64
         Poke Start(10)+POS+1,Y#+64

         X=64+((Abs(X#)*3.45)*Tan(32-DIST#))
         Y=64+((Abs(Y#)*3.45)*Tan(32-DIST#))
         POS=(Y*256)+(X*2)
         Poke Start(10)+POS,Abs(X#)+64
         Poke Start(10)+POS+1,Abs(Y#)+64

         X=64+((X#*3.45)*Tan(32-DIST#))
         Y=64+((Abs(Y#)*3.45)*Tan(32-DIST#))
         POS=(Y*256)+(X*2)
         Poke Start(10)+POS,X#+64
         Poke Start(10)+POS+1,Abs(Y#)+64

      Next X#
   Next Y#
End If

For P=0 To 255
   For Y=0 To 127
      For X=0 To 127
         POS=(Y*256)+(X*2)
         X2=Peek(Start(10)+POS)
         If X2<255
            Y2=Peek(Start(10)+POS+1)
            Screen 1 : C=Point((X2+P) mod 256,Y2) : Screen 0
            Plot X,Y,C
         End If
      Next X
   Next Y
   NAME$="ram:GlobeAnim."
   P$=Str$(P)-" "
   NAME$=NAME$+String$("0",3-Len(P$))+P$
   Save Iff NAME$
Next P

