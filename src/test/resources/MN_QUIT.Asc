Procedure MN_QUIT

   ' Quit the program

   D=2
   If BKCHANGE
      D=Dialog Box(1,1,Resource$(60))
   End If

   If D=2

      If BGRB
         D=Dialog Box(1,1,Resource$(61))
         If D=2
            BNK_CREATE
            If Param>=0
               Bsend BK
            Else
               D=Dialog Box(1,2,Resource$(62))
               Pop Proc
            End If
         Else
            D=Dialog Box(1,1,Resource$(63))
            If D<>2 : Pop Proc : End If
         End If
      End If

      Dialog Close 1
      Screen Close 0 : If PNAME$<>"" : Screen Close 1 : End If
      BANK_NEW : Edit

   End If

End Proc