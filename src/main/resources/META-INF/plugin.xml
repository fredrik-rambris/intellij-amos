<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>dev.rambris.amiga-amos</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>AMOS</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://fredrik.rambris.com">Fredrik Rambris</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Adds support for the AMOS Basic language used in AMOS Professional on the Amiga Computer
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensionPoints>
        <extensionPoint
                qualifiedName="dev.rambris.amigaamos.definitionResource"
                beanClass="dev.rambris.amigaamos.lang.amos.AmosDefinitionResourceBean"
                dynamic="true"/>
    </extensionPoints>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>
    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="AMOS File"
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosFileType"
                fieldName="INSTANCE"
                extensions="asc;amosasc;amosbas"/>
        <fileTypeDetector implementation="dev.rambris.amigaamos.lang.amos.AmosFileTypeOverrider"/>
        <fileType
                name="AMAL File"
                language="AMAL"
                implementationClass="dev.rambris.amigaamos.lang.amal.AmalFileType"
                fieldName="INSTANCE"
                extensions="amal"/>
        <fileType
                name="AMOS Interface File"
                language="AMUI"
                implementationClass="dev.rambris.amigaamos.lang.amui.AmuiFileType"
                fieldName="INSTANCE"
                extensions="amui"/>

        <lang.syntaxHighlighterFactory
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosSyntaxHighlighterFactory"/>
        <lang.syntaxHighlighterFactory
                language="AMAL"
                implementationClass="dev.rambris.amigaamos.lang.amal.AmalSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="dev.rambris.amigaamos.lang.amos.AmosColorSettingsPage"/>
        <colorSettingsPage implementation="dev.rambris.amigaamos.lang.amal.AmalColorSettingsPage"/>
        <projectConfigurable
                id="settings.amos"
                parentId="language"
                displayName="AMOS"
                instance="dev.rambris.amigaamos.lang.amos.AmosProjectConfigurable"/>
        <projectConfigurable
                id="settings.amos.definitions"
                parentId="settings.amos"
                displayName="Definitions"
                instance="dev.rambris.amigaamos.lang.amos.AmosDefinitionProjectConfigurable"/>
        <lang.parserDefinition
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosParserDefinition"/>
        <annotator
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosProcedureNameAnnotator"/>
        <lang.formatter
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosFormattingModelBuilder"/>
        <lang.lineIndentProvider
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosLineIndentProvider"/>
        <lang.foldingBuilder
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosFoldingBuilder"/>
        <completion.contributor
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosCompletionContributor"/>
        <completion.confidence
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosCompletionConfidence"
                order="first"/>
        <gotoDeclarationHandler
                implementation="dev.rambris.amigaamos.lang.amos.AmosGotoDeclarationHandler"/>
        <renameHandler
                implementation="dev.rambris.amigaamos.lang.amos.AmosRenameHandler"/>
        <lang.findUsagesProvider
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosFindUsagesProvider"/>
        <codeInsight.parameterInfo
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosParameterInfoHandler"/>
        <lang.documentationProvider
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosDocumentationProvider"/>
        <lang.documentationProvider
                language="AMAL"
                implementationClass="dev.rambris.amigaamos.lang.amal.AmalDocumentationProvider"/>
        <typedHandler implementation="dev.rambris.amigaamos.lang.amos.AmosTypedHandler"/>
        <lang.commenter
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosCommenter"/>
        <localInspection
                language="AMOS"
                shortName="AmosSetBufferPosition"
                displayName="Set Buffer should be first instruction"
                groupName="AMOS"
                groupPath="AMOS"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.rambris.amigaamos.lang.amos.AmosSetBufferPositionInspection"/>
        <postFormatProcessor implementation="dev.rambris.amigaamos.lang.amos.AmosPostFormatProcessor"/>
        <enterHandlerDelegate
                implementation="dev.rambris.amigaamos.lang.amos.AmosEnterHandlerDelegate"/>
    </extensions>
    <extensions defaultExtensionNs="dev.rambris.amigaamos">
        <definitionResource resourcePath="amos/definitions/core.json"/>
        <definitionResource resourcePath="amos/definitions/compact.json"/>
        <definitionResource resourcePath="amos/definitions/ioports.json"/>
        <definitionResource resourcePath="amos/definitions/music.json"/>
        <definitionResource resourcePath="amos/definitions/request.json"/>
        <definitionResource resourcePath="amos/definitions/compiler.json"/>
    </extensions>
</idea-plugin>