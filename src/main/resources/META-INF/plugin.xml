<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>dev.rambris.amiga-amos</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>AMOS</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://fredrik.rambris.com">Fredrik Rambris</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Adds support for the AMOS Basic language used in AMOS Professional on the Amiga Computer
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <extensionPoints>
        <extensionPoint
                qualifiedName="dev.rambris.amigaamos.definitionResource"
                beanClass="dev.rambris.amigaamos.lang.AmosDefinitionResourceBean"
                dynamic="true"/>
    </extensionPoints>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>
    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="AMOS File"
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.AmosFileType"
                fieldName="INSTANCE"
                extensions="asc;amosasc;amosbas"/>
        <lang.syntaxHighlighterFactory
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.AmosSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="dev.rambris.amigaamos.lang.AmosColorSettingsPage"/>
        <projectConfigurable
                id="settings.amos"
                parentId="language"
                displayName="AMOS"
                instance="dev.rambris.amigaamos.lang.AmosProjectConfigurable"/>
        <projectConfigurable
                id="settings.amos.definitions"
                parentId="settings.amos"
                displayName="Definitions"
                instance="dev.rambris.amigaamos.lang.AmosDefinitionProjectConfigurable"/>
        <lang.parserDefinition
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.AmosParserDefinition"/>
        <annotator
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.AmosProcedureNameAnnotator"/>
        <lang.formatter
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.AmosFormattingModelBuilder"/>
        <lang.lineIndentProvider
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.AmosLineIndentProvider"/>
        <lang.foldingBuilder
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.AmosFoldingBuilder"/>
        <completion.contributor
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.AmosCompletionContributor"/>
        <completion.confidence
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.AmosCompletionConfidence"
                order="first"/>
        <gotoDeclarationHandler
                implementation="dev.rambris.amigaamos.lang.AmosGotoDeclarationHandler"/>
        <renameHandler
                implementation="dev.rambris.amigaamos.lang.AmosRenameHandler"/>
        <lang.findUsagesProvider
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.AmosFindUsagesProvider"/>
        <codeInsight.parameterInfo
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.AmosParameterInfoHandler"/>
        <lang.documentationProvider
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.AmosDocumentationProvider"/>
        <documentationProvider
                implementation="dev.rambris.amigaamos.lang.AmosDocumentationProvider"/>
        <typedHandler implementationClass="dev.rambris.amigaamos.lang.AmosTypedHandler"/>
        <lang.commenter
                language="AMOS"
                implementationClass="dev.rambris.amigaamos.lang.AmosCommenter"/>
        <localInspection
                language="AMOS"
                shortName="AmosSetBufferPosition"
                displayName="Set Buffer should be first instruction"
                groupName="AMOS"
                groupPath="AMOS"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.rambris.amigaamos.lang.AmosSetBufferPositionInspection"/>
        <postFormatProcessor implementation="dev.rambris.amigaamos.lang.AmosPostFormatProcessor"/>
        <enterHandlerDelegate
                implementation="dev.rambris.amigaamos.lang.AmosEnterHandlerDelegate"/>
    </extensions>
    <extensions defaultExtensionNs="dev.rambris.amigaamos">
        <definitionResource resourcePath="amos/definitions/core.json"/>
        <definitionResource resourcePath="amos/definitions/compact.json"/>
        <definitionResource resourcePath="amos/definitions/ioports.json"/>
        <definitionResource resourcePath="amos/definitions/music.json"/>
        <definitionResource resourcePath="amos/definitions/request.json"/>
    </extensions>
</idea-plugin>